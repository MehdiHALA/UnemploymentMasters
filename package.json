{
  "name": "psn-discord-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/worker.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --no-warnings --test \"test/*.test.mjs\"",
    "check": "node --check src/worker.js && node --check scripts/register-commands.js && npm test",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:register": "node scripts/register-commands.js",
    "cf:schema": "wrangler d1 execute psn-trophy-bot-db --remote --file schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.100.0"
  }
}
